version: "2"
linters:
  default: standard
  enable:
    - errorlint
    - misspell
    - revive
    - unconvert
  settings:
    errcheck:
      # Writing CLI output to an io.Writer: nothing useful to do on failure.
      exclude-functions:
        - fmt.Fprint
        - fmt.Fprintf
        - fmt.Fprintln
formatters:
  enable:
    - gofmt
    - goimports
  settings:
    goimports:
      # Keep the project's own packages in a separate import group.
      local-prefixes:
        - <% .Module %>
