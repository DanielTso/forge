.DEFAULT_GOAL := help

.PHONY: help
help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-12s %s\n", $$1, $$2}'

.PHONY: build
build: ## Build in release mode
	cargo build --release

.PHONY: run
run: ## Run the binary
	cargo run --quiet

.PHONY: test
test: ## Run tests
	cargo test

.PHONY: fmt
fmt: ## Format code
	cargo fmt

.PHONY: lint
lint: ## Run clippy (warnings are errors)
	cargo clippy --all-targets -- -D warnings

.PHONY: check
check: ## Check formatting, lint and test
	cargo fmt --check
	$(MAKE) lint
	$(MAKE) test

.PHONY: clean
clean: ## Remove build artifacts
	cargo clean
