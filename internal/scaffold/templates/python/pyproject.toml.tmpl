[build-system]
requires = ["hatchling>=1.27"]
build-backend = "hatchling.build"

[project]
name = "<% .Name %>"
version = "0.1.0"
description = "<% .Description %>"
readme = "README.md"
requires-python = ">=3.10"
<% if ne .License "none" -%>
license = "<% .License %>"
<% end -%>
authors = [{ name = "<% .Author %>" }]
dependencies = []

[project.optional-dependencies]
dev = ["pytest>=8", "ruff>=0.6", "mypy>=1.10"]

[project.scripts]
<% .Name %> = "<% .Snake %>.cli:main"

[tool.hatch.build.targets.wheel]
packages = ["src/<% .Snake %>"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
line-length = 100
src = ["src", "tests"]

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

[tool.mypy]
strict = true
files = ["src"]
