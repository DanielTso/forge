import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import { test } from "node:test";
import { fileURLToPath } from "node:url";

import { greet } from "../src/index.js";

// Tests run from dist/test/, next to the compiled CLI in dist/src/.
const cli = fileURLToPath(new URL("../src/cli.js", import.meta.url));

test("greet", () => {
  assert.equal(greet("Gopher"), "Hello, Gopher!");
  assert.equal(greet(), "Hello, world!");
});

test("cli greets the world by default", () => {
  assert.equal(execFileSync(process.execPath, [cli], { encoding: "utf8" }), "Hello, world!\n");
});

test("cli greets a name", () => {
  assert.equal(execFileSync(process.execPath, [cli, "Ada"], { encoding: "utf8" }), "Hello, Ada!\n");
});
